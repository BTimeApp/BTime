{
  "name": "btime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "pnpm --filter ./packages build && pnpm --filter ./website build",
    "lint": "pnpm --filter ./packages lint && pnpm --filter ./website lint",
    "start": "pnpm --filter ./website start",
    "lint:fix": "pnpm --filter ./packages lint:fix && pnpm --filter ./website lint:fix",
    "build-packages": "pnpm --filter ./packages build",
    "lint-packages": "pnpm --filter ./packages lint",
    "lint:fix-packages": "pnpm --filter ./packages lint:fix",
    "dev-website": "pnpm --filter ./website dev",
    "build-website": "pnpm --filter ./website/* build",
    "start-website": "pnpm --filter ./website start",
    "lint-website": "pnpm --filter ./website lint",
    "lint:fix-website": "pnpm --filter ./website lint:fix"
  }
}
