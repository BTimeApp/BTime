{
  "name": "@btime/bluetooth-cubing-react",
  "version": "0.1.0",
  "description": "React hooks for bluetooth-cubing",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --tsconfig tsconfig.json",
    "dev": "tsup src/index.ts --watch --tsconfig tsconfig.json",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "keywords": [
    "bluetooth",
    "rubiks",
    "cube"
  ],
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "path": "^0.12.7",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "url": "^0.11.4"
  },
  "dependencies": {
    "@btime/bluetooth-cubing": "workspace:*",
    "cubing": "~0.58.2"
  }
}
