{
  "name": "@btime/virtual-cubing-react",
  "version": "0.1.0",
  "description": "Virtual cube renderer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --tsconfig tsconfig.json",
    "dev": "tsup src/index.ts --watch --tsconfig tsconfig.json",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/react": "^19.2.8",
    "@types/three": "^0.182.0",
    "cubing": "~0.58.2",
    "react": "^19.2.3",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "path": "^0.12.7",
    "tsup": "^8.5.1",
    "url": "^0.11.4"
  }
}
