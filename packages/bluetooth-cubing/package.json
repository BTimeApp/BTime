{
  "name": "@btime/bluetooth-cubing",
  "version": "0.1.0",
  "description": "Library for bluetooth cubes and timers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --tsconfig tsconfig.json",
    "dev": "tsup src/index.ts --watch --tsconfig tsconfig.json",
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix"
  },
  "keywords": [
    "bluetooth",
    "rubiks",
    "cube"
  ],
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/web-bluetooth": "^0.0.21",
    "cac": "^6.7.14",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "path": "^0.12.7",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.51.0",
    "url": "^0.11.4"
  },
  "dependencies": {
    "cubing": "^0.58.0",
    "lz-string": "^1.5.0"
  }
}
