{
  "name": "btime-website",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --filter './frontend' --filter './backend' dev",
    "dev:frontend": "pnpm -r --filter './frontend'",
    "dev:backend": "pnpm -r --filter './backend'",
    "build": "pnpm -r build",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend"
  }
}
